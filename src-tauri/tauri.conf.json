{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pawang Layar",
  "version": "1.0.0",
  "identifier": "digital.yumastudio.pawanglayar",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pawang Layar",
        "width": 1140,
        "height": 760,
        "minWidth": 380,
        "minHeight": 540,
        "center": true,
        "transparent": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}

